\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces Earlier \texttt  {ibm\_fez} run (Heron~r2, $p_{2q}=2.6\times 10^{-3}$, 10 trials), executed 2026-05-02: per-$k$ success reaching $n{=}12$. This run locates the device noise wall at $n\!\ge \!11$ (best-$k$ indistinguishable from the $k{=}0$ control) and shows the textbook $k^{*}$ collapsing while $k{=}1$ stays optimal. The wall-region job IDs ($n{=}10$--$12$) are listed in the Reproducibility section. Parenthesised values are the iteration count at that column.}}{7}{table.9}\protected@file@percent }
\newlabel{tab:perk}{{IX}{7}{Earlier \texttt {ibm\_fez} run (Heron~r2, $p_{2q}=2.6\times 10^{-3}$, 10 trials), executed 2026-05-02: per-$k$ success reaching $n{=}12$. This run locates the device noise wall at $n\!\ge \!11$ (best-$k$ indistinguishable from the $k{=}0$ control) and shows the textbook $k^{*}$ collapsing while $k{=}1$ stays optimal. The wall-region job IDs ($n{=}10$--$12$) are listed in the Reproducibility section. Parenthesised values are the iteration count at that column}{table.9}{}}
