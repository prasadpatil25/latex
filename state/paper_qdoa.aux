\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Per-stage logical two-qubit (CNOT) gate counts for a single marked state, by $n$. MCZ $=6(n{-}2)$; oracle and diffusion each apply one MCZ; a $k{=}1$ Grover circuit is one oracle plus one diffusion. Ancillas are clean (restored to $\ensuremath  {|0\rangle }$). The last column is the calibration-model per-iteration fidelity $F_{\mathrm  {iter}}=(1{-}p_{2q})^{g_{2q}}$ at $p_{2q}=2.6\times 10^{-3}$.}}{3}{table.3}\protected@file@percent }
\newlabel{tab:gatecost}{{III}{3}{Per-stage logical two-qubit (CNOT) gate counts for a single marked state, by $n$. MCZ $=6(n{-}2)$; oracle and diffusion each apply one MCZ; a $k{=}1$ Grover circuit is one oracle plus one diffusion. Ancillas are clean (restored to $\ket {0}$). The last column is the calibration-model per-iteration fidelity $F_{\mathrm {iter}}=(1{-}p_{2q})^{g_{2q}}$ at $p_{2q}=2.6\times 10^{-3}$}{table.3}{}}
