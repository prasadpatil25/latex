\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The QDOA pipeline. Candidate segmentations are generated classically (Stage~0), marked by a grammar phase oracle that accepts a candidate if either its noun or its verb reading is valid (Stage~1), amplified and ranked by Grover amplitude amplification at the empirically optimal $k{=}1$ (Stage~2), and filtered for out-of-vocabulary words by a trained 3-qubit PQC (Stage~3). The grammar oracle's linguistic content is specified classically; the search over it is quantum.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{5}{The QDOA pipeline. Candidate segmentations are generated classically (Stage~0), marked by a grammar phase oracle that accepts a candidate if either its noun or its verb reading is valid (Stage~1), amplified and ranked by Grover amplitude amplification at the empirically optimal $k{=}1$ (Stage~2), and filtered for out-of-vocabulary words by a trained 3-qubit PQC (Stage~3). The grammar oracle's linguistic content is specified classically; the search over it is quantum}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Morphological benchmark Top-1 accuracy. The classical path is deterministic. Quantum figures are mean\,$\pm $\,std over $K{=}20$ independent PQC trainings (fresh 60-iteration SPSA per trial; range in brackets for NISQ). Noise is essentially neutral---the noiseless (ideal) and NISQ means coincide within one standard deviation---so the spread is driven by PQC training, not hardware noise. The quantum mean sits a modest $\sim $7 (IV) / $\sim $5 (OOV) points below the deterministic classical baseline, with the best trainings reaching parity or above.}}{5}{table.5}\protected@file@percent }
\newlabel{tab:morphacc}{{V}{5}{Morphological benchmark Top-1 accuracy. The classical path is deterministic. Quantum figures are mean\,$\pm $\,std over $K{=}20$ independent PQC trainings (fresh 60-iteration SPSA per trial; range in brackets for NISQ). Noise is essentially neutral---the noiseless (ideal) and NISQ means coincide within one standard deviation---so the spread is driven by PQC training, not hardware noise. The quantum mean sits a modest $\sim $7 (IV) / $\sim $5 (OOV) points below the deterministic classical baseline, with the best trainings reaching parity or above}{table.5}{}}
